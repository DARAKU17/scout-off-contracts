# Rust / Cargo
target/
Cargo.lock

# Environment secrets — never commit these
.env
.env.contracts
.env.local

# Optimized WASM outputs
*.optimized.wasm

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.swp
*.swo

# Kiro IDE
.kiro/

# Pull-request drafts
pr-*.md

# Bindings — generated src/ and compiled dist/ are not committed.
# Only package.json and tsconfig.json scaffolds are tracked.
bindings/*/src/
bindings/*/dist/
bindings/*/node_modules/

# Soroban test snapshots — generated automatically, not reviewed in PRs.
# Re-generated on next test run.
**/test_snapshots/

# Temporary files
*.tmp
*.bak
